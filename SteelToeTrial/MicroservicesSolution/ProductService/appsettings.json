{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spring": {
    "Application": {
      "Name": "product-service"
    },
    "Cloud": {
      "Config": {
        "Uri": "http://config-server:8888",
        "FailFast": true,
        "Retry": {
          "Enabled": true
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8081"
      }
    }
  }
}